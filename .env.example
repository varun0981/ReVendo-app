# Copy to .env for Docker Compose. Keep all actual values local and untracked.
NODE_ENV=development
FRONTEND_PORT=8080
CLIENT_URL=http://localhost:8080
MONGO_URI=mongodb://mongo:27017/revendo
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional external MongoDB Atlas URI; URL-encode special characters in credentials.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/revendo?retryWrites=true&w=majority

# Set private values here only if you intend to run the admin seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional integrations; leave blank to use local development simulations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
