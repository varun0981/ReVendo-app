{
  "name": "revendo-marketplace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client",
    "seed": "npm run seed --prefix server && npm run seed:admin --prefix server",
    "seed:products": "npm run seed --prefix server",
    "seed:admin": "npm run seed:admin --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
