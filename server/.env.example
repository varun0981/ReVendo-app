PORT=5051
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/revendo
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
EMAIL_FROM=ReVendo <no-reply@revendo.local>
# Leave SMTP settings blank to use the labeled development email simulation.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional Twilio SMS delivery. Without these values, development uses OTP 123456.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Razorpay test mode only. Keep the secret on the server and never use live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_EMAIL=admin@revendo.local
ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
